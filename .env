# 启用数据库功能（必需）
DB_ENABLED=true

# 应用配置
PORT=8888
CHANNELS=tgsearchers4
CONCURRENCY=20

# 代理配置（可选）
# PROXY=socks5://127.0.0.1:1080

# 缓存配置
CACHE_ENABLED=true
CACHE_PATH=./cache
CACHE_MAX_SIZE=100
CACHE_TTL=60

# 数据库配置
DB_ENABLED=false           # 是否启用数据库功能
DB_HOST=localhost          # 数据库主机
DB_PORT=3306              # 数据库端口
DB_USER=root              # 数据库用户名
DB_PASSWORD=              # 数据库密码
DB_NAME=pansou            # 数据库名称
DB_MAX_IDLE=10            # 最大空闲连接数
DB_MAX_OPEN=100           # 最大打开连接数

# 插件配置
ASYNC_PLUGIN_ENABLED=true
ENABLED_PLUGINS=          # 留空表示不启用任何插件，设置具体插件名则启用指定插件

# 认证配置
AUTH_ENABLED=false
# AUTH_USERS=user1:pass1,user2:pass2
# AUTH_JWT_SECRET=your-secret-key
# AUTH_TOKEN_EXPIRY=24
